{
  "manifest_version": 3,
  "name": "E-TA FT UNMUL Bulk Bimbingan",
  "version": "1.1.0",
  "description": "Bulk input bimbingan dari CSV ke form E-TA (mode isi manual).",
  "action": {
    "default_title": "Bulk Bimbingan",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://e-office.ft.unmul.ac.id/mahasiswa/e-ta/*"],
  "content_scripts": [
    {
      "matches": ["https://e-office.ft.unmul.ac.id/mahasiswa/e-ta/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["https://e-office.ft.unmul.ac.id/*"]
    }
  ]
}
